{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome ou Raz\u00e3o Social do fornecedor"
    },
    "cnpj_cpf": {
      "type": "string",
      "description": "CNPJ ou CPF do fornecedor"
    },
    "email": {
      "type": "string",
      "description": "E-mail de contato"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos produtos fornecidos"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}